# Single-source transcriber native-tool pin. Updating whisper.cpp should be a
# small, auditable change here, followed by the Transcriber tools workflow.
WHISPER_CPP_REPO=https://github.com/ggml-org/whisper.cpp.git
WHISPER_CPP_REF=v1.8.4

# Match the module/helper APK minimum SDK. Keep the default engine CPU-only and
# generic so it works across the broadest range of rooted Android devices.
ANDROID_PLATFORM=android-28
ANDROID_NDK_VERSION=27.3.13750724
ANDROID_CMAKE_VERSION=3.31.6
ANDROID_ABIS="arm64-v8a armeabi-v7a x86_64"

# Stable release bucket used by Prepare Components.
TOOLS_RELEASE_TAG=transcriber-tools
